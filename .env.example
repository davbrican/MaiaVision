# Copy to .env, generate ALL secrets, never commit this file.
# python scripts/hash_password.py prints a safely single-quoted hash assignment.
MAIA_ADMIN_USER=admin
MAIA_ADMIN_PASSWORD_HASH=CHANGEME
MAIA_SESSION_SECRET=CHANGEME
MAIA_EDGE_TOKEN=CHANGEME
# Local development only. On VPS replace with https://maiavision.dbrincau.com and true.
MAIA_PUBLIC_ORIGIN=http://localhost:8102
MAIA_COOKIE_SECURE=false
# Keep quoted: valid for Docker Compose env_file AND 'source .env' in a shell.
MAIA_CAMERAS_JSON='{"webcam":"Webcam MacBook","android":"Android WiFi","cam3":"Pasillo"}'
