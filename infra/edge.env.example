# Copy on Raspberry ONLY to repo-root edge.env, chmod 600, never commit.
# Do NOT copy full VPS .env to Raspberry: edge requires no administrator hash or session secret.
MAIA_EDGE_TOKEN=CHANGEME
MAIA_BACKEND_URL=https://maia.example.com
MAIA_SALON_URL='rtsp://CAMERA_SALON_URL_REAL'
MAIA_ANDROID_URL='http://ANDROID_IP:PUERTO/RUTA_REAL'
MAIA_PASILLO_URL='rtsp://CAMERA_PASILLO_URL_REAL'
